// ============================================================
// IMPORTANT ARDUINO IDE TYPE DECLARATIONS
// ============================================================
//
// Arduino auto-generates function prototypes near the top of a .ino file.
// Any custom return/argument type used by those functions must already be
// declared before Arduino inserts those prototypes.
//
// Keeping these here fixes errors like:
//   'PressType' does not name a type
//   'JuniState' was not declared in this scope
//
enum PressType : uint8_t {
  PRESS_NONE,
  PRESS_SHORT,
  PRESS_LONG
};

// Everything one call to readButton() can report.
struct ButtonEvents {
  bool down;         // debounced press edge (finger just went down)
  bool up;           // debounced release edge
  PressType press;   // SHORT fires on release, LONG fires while still held
};

// THE STATE MACHINE
//
// JUNI is always in exactly one of these states, held in `currentState`.
// Each state decides what the knob does, and a state only changes inside
// enterState(). That is what keeps the behaviour predictable: to know what a
// press does, find the current state's case in updateCurrentState().
//
// JuniUI (juni_idle.h) has its own list of *screens*. toUiState() maps each
// application state onto the screen that already shows it, so no visuals
// changed. The one naming difference: PAUSED is drawn with the UI's existing
// BREAK screen, which has always been the pause screen ("Break" pill).
enum class JuniState : uint8_t {
  IDLE,       // resting panda, "turn to set"
  SET_TIME,   // choosing the minutes
  STARTING,   // 0.7 s "Let's go" bridge before the countdown
  FOCUSING,   // countdown running
  PAUSED,     // countdown frozen
  COMPLETE,   // "Well done!"
  CANCELLED   // 1.2 s "Cancelled", then back to IDLE
};


// ============================================================
// 1. CURRENT JUNI HARDWARE
// ============================================================

// ---------- TFT ----------
#define TFT_CS     10
#define TFT_RST     9
#define TFT_DC      4
#define TFT_MOSI   11
#define TFT_SCLK   12
#define TFT_MISO   13     // optional / currently not required

// ---------- Rotary encoder ----------
#define ENC_S1      6
#define ENC_S2      7
#define ENC_KEY     8

// Change to 1 only if clockwise decreases the time.
#define ENC_INVERT  0

// Most KY-040-style encoders generate 4 quadrature steps per click.
// If one physical click does not equal one 5-minute change, try 2.
#define ENC_STEPS_PER_DETENT 4

#define TFT_SPI_HZ 40000000

// ---------- TFT backlight (BL / BLK / LED pin on the display) ----------
// -1 = not connected to the ESP32. That is the current wiring: nothing in this
// firmware has ever driven the backlight, so it is either tied to 3.3 V or left
// on the module's own pull-up. The dimming logic still runs and logs, but the
// screen cannot actually get darker until BL goes to a GPIO.
//
// To enable real dimming: run a wire from the display's BL pin to a free GPIO
// (GPIO 5 is a good choice on this board) and set that number here.
#define TFT_BL_PIN  -1


