// JUNI — full focus-companion firmware
// Arduino IDE version adapted to the CURRENT working juni_well_done hardware setup.
//
// Hardware kept exactly on the current JUNI pins:
//   TFT: CS 10, RST 9, DC 4, MOSI 11, SCLK 12 (MISO 13 optional)
//   Encoder: S1 6, S2 7, KEY 8
//
// Display stack kept from the current working sketch:
//   Adafruit_GFX + Adafruit_ST7789
//
// Visual layer:
//   juni_ui.h = all 7 product states + expressions + transitions

#include <Arduino.h>
#include <SPI.h>
#include <string.h>

#include <Adafruit_GFX.h>
#include <Adafruit_ST7789.h>

#include <Fonts/FreeSansBold9pt7b.h>
#include <Fonts/FreeSansBold12pt7b.h>
