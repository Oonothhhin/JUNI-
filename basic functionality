/* =========================================================================
   1.  CONFIGURATION
   ========================================================================= */

#define TFT_CS    10
#define TFT_RST    9
#define TFT_DC     4
#define TFT_MOSI  11
#define TFT_SCLK  12

#define ENC_S1     6
#define ENC_S2     7
#define ENC_KEY    8

// If the display shows tearing or confetti noise, drop this to 24000000
// (the Adafruit default). 40 MHz roughly halves every flush time.
#define TFT_SPI_HZ 40000000

// Set to 1 if turning the knob clockwise decreases the time on your unit.
#define ENC_INVERT 0

// Very subtle 1.5 px vertical "breathing" pulse. Set to 0 to disable.
#define JUNI_BREATHING 1

// Serial state trace, useful while testing each state.
#define JUNI_DEBUG 1

#define SCREEN_W 240
#define SCREEN_H 320

// Animation frame budget: ~33 fps ceiling. Nothing redraws when idle.
#define FRAME_MS 30

Adafruit_ST7789 tft = Adafruit_ST7789(TFT_CS, TFT_DC, TFT_RST);


/* =========================================================================
   2.  TYPES
   -------------------------------------------------------------------------
   Declarations only. No function definitions in this section -- see the
   note in the file header for why that matters.
   ========================================================================= */

// ---- colour -------------------------------------------------------------

struct Col { uint8_t r, g, b; };

// ---- rectangles ---------------------------------------------------------

struct Rect { int16_t x, y, w, h; };

// ---- easing -------------------------------------------------------------

enum Ease : uint8_t { EASE_LINEAR, EASE_SMOOTHSTEP, EASE_OUT_CUBIC, EASE_IN_OUT_CUBIC };

// ---- panda expressions --------------------------------------------------

enum PandaExpression : uint8_t {
  PANDA_IDLE,
  PANDA_BLINK,      // not a sequence: triggers one blink on the current face
  PANDA_START,
  PANDA_FOCUS,
  PANDA_BREAK,
  PANDA_WAKE,
  PANDA_CANCEL,
  PANDA_FINISH,
  PANDA_WINK,
  PANDA_EXPR_COUNT
};

enum EyeStyle   : uint8_t { EYE_OVAL, EYE_SLEEPY, EYE_HAPPY, EYE_WINK_R };
enum MouthStyle : uint8_t { MOUTH_W, MOUTH_SMILE, MOUTH_BIG_SMILE, MOUTH_FLAT, MOUTH_DOWN };

// A single moment of the face. Every expression is a list of these.
struct FaceKey {
  uint16_t t;         // ms from sequence start
  float    eyeOpen;   // 0 = shut, 1 = normal, >1 = widened
  uint8_t  eyeStyle;
  uint8_t  mouth;
  float    bob;       // px, negative = face lifts
  float    wide;      // eye width multiplier
  float    gazeY;     // -1..1, shifts eyes/highlights down when positive
  float    sparkle;   // 0..1
};

struct FaceSeq {
  const FaceKey *k;
  uint8_t  n;
  uint8_t  next;      // auto-advance to this expression when finished
  bool     blink;     // allow idle blinking while holding the last key
  bool     breathe;   // allow the breathing pulse while holding
};

// Live face state, rebuilt every animation frame.
struct FaceState {
  float   eyeOpen, wide, gazeX, gazeY, sparkle, bob;
  uint8_t eyeStyle, mouth;
};

// A face plus where and how big to draw it.
struct FaceRender {
  float cx, cy, scale, alpha;
  FaceState f;
};

// ---- render layers ------------------------------------------------------

enum Layer : uint8_t { L_PANDA, L_TIMER, L_DOT, L_COUNT };

struct TimerRender {
  char    str[16];
  float   cy, scale, alpha;
  int16_t w, h;
};

// ---- application state --------------------------------------------------

enum AppState : uint8_t {
  IDLE,
  TIME_SELECT,
  STARTING,
  FOCUS,
  BREAK,
  CANCELING,
  FINISHED
};

// Interpolatable screen layout: every transition is a tween between two of
// these, so panda and timer positions/scales/fades move together.
struct Layout {
  float pandaCy, pandaScale, pandaAlpha;
  float timerCy, timerScale, timerAlpha;
};

/* ---- framebuffer -------------------------------------------------------
   A full 240x320 RGB565 buffer (150 KB) living in PSRAM. Every draw call in
   the whole sketch lands here, never on the panel. Each operation expands a
   dirty rectangle; flush() then pushes ONLY that rectangle over SPI.

   That is the entire anti-flicker strategy: the panel never sees a cleared
   screen or a partially drawn frame, and untouched regions cost nothing.

   The inline members below deliberately call no free functions, so this
   class can sit up here in the types section.
   ----------------------------------------------------------------------- */

class JuniFB : public Adafruit_GFX {
public:
  uint16_t *buf = nullptr;
  int16_t dx0, dy0, dx1, dy1;   // dirty rect; dx1 < dx0 means "empty"

  JuniFB() : Adafruit_GFX(SCREEN_W, SCREEN_H) { clearDirty(); }

  bool begin() {
    size_t bytes = (size_t)SCREEN_W * SCREEN_H * 2;
    buf = (uint16_t *)ps_malloc(bytes);          // PSRAM first
    if (!buf) buf = (uint16_t *)malloc(bytes);   // internal RAM fallback
    if (!buf) return false;
    memset(buf, 0, bytes);
    return true;
  }

  inline void clearDirty() { dx0 = SCREEN_W; dy0 = SCREEN_H; dx1 = -1; dy1 = -1; }
  inline bool hasDirty() const { return dx1 >= dx0 && dy1 >= dy0; }

  void mark(int16_t x, int16_t y, int16_t w, int16_t h) {
    if (w <= 0 || h <= 0) return;
    int16_t xa = x, ya = y, xb = x + w - 1, yb = y + h - 1;
    if (xa < 0) xa = 0;
    if (ya < 0) ya = 0;
    if (xb > SCREEN_W - 1) xb = SCREEN_W - 1;
    if (yb > SCREEN_H - 1) yb = SCREEN_H - 1;
    if (xb < xa || yb < ya) return;
    if (xa < dx0) dx0 = xa;
    if (ya < dy0) dy0 = ya;
    if (xb > dx1) dx1 = xb;
    if (yb > dy1) dy1 = yb;
  }

  // ---- raw writers: bounds-checked, but they do NOT mark dirty. Layer
  //      draw code always erases its own span first (which marks), and the
  //      span is guaranteed to enclose everything the layer draws.
  inline void px(int16_t x, int16_t y, uint16_t c) {
    if ((uint16_t)x >= SCREEN_W || (uint16_t)y >= SCREEN_H) return;
    buf[(int32_t)y * SCREEN_W + x] = c;
  }

  inline void hline(int16_t x, int16_t y, int16_t w, uint16_t c) {
    if ((uint16_t)y >= SCREEN_H || w <= 0) return;
    if (x < 0) { w += x; x = 0; }
    if (x + w > SCREEN_W) w = SCREEN_W - x;
    if (w <= 0) return;
    uint16_t *p = &buf[(int32_t)y * SCREEN_W + x];
    while (w--) *p++ = c;
  }

  // Coverage blend of colour c over whatever is already in the buffer.
  // Done directly in 565 space -- plenty accurate for edge antialiasing.
  inline void blend(int16_t x, int16_t y, const Col &c, uint8_t a) {
    if ((uint16_t)x >= SCREEN_W || (uint16_t)y >= SCREEN_H) return;
    if (a == 0) return;
    int32_t i = (int32_t)y * SCREEN_W + x;
    if (a >= 250) {
      buf[i] = (uint16_t)(((uint16_t)(c.r & 0xF8) << 8) |
                          ((uint16_t)(c.g & 0xFC) << 3) | (c.b >> 3));
      return;
    }
    uint16_t d = buf[i];
    uint16_t dr = (d >> 11) & 0x1F, dg = (d >> 5) & 0x3F, db = d & 0x1F;
    uint16_t sr = c.r >> 3,         sg = c.g >> 2,        sb = c.b >> 3;
    uint16_t ia = 255 - a;
    uint16_t nr = (uint16_t)((sr * a + dr * ia + 127) / 255);
    uint16_t ng = (uint16_t)((sg * a + dg * ia + 127) / 255);
    uint16_t nb = (uint16_t)((sb * a + db * ia + 127) / 255);
    buf[i] = (nr << 11) | (ng << 5) | nb;
  }

  // ---- Adafruit_GFX overrides (these DO mark dirty) --------------------
  void drawPixel(int16_t x, int16_t y, uint16_t c) override {
    if ((uint16_t)x >= SCREEN_W || (uint16_t)y >= SCREEN_H) return;
    buf[(int32_t)y * SCREEN_W + x] = c;
    mark(x, y, 1, 1);
  }

  void drawFastHLine(int16_t x, int16_t y, int16_t w, uint16_t c) override {
    hline(x, y, w, c);
    mark(x, y, w, 1);
  }

  void drawFastVLine(int16_t x, int16_t y, int16_t h, uint16_t c) override {
    for (int16_t i = 0; i < h; i++) px(x, y + i, c);
    mark(x, y, 1, h);
  }

  void fillRect(int16_t x, int16_t y, int16_t w, int16_t h, uint16_t c) override {
    for (int16_t r = 0; r < h; r++) hline(x, y + r, w, c);
    mark(x, y, w, h);
  }

  void fillScreen(uint16_t c) override {
    if (c == 0) memset(buf, 0, (size_t)SCREEN_W * SCREEN_H * 2);
    else for (int32_t i = 0; i < (int32_t)SCREEN_W * SCREEN_H; i++) buf[i] = c;
    mark(0, 0, SCREEN_W, SCREEN_H);
  }

  void fillRectR(const Rect &r, uint16_t c) {
    if (r.w > 0 && r.h > 0) fillRect(r.x, r.y, r.w, r.h, c);
  }

  void flush();   // defined in section 4 (needs `tft`)
};

JuniFB fb;


/* =========================================================================
   3.  COLOUR + MATH HELPERS
   ========================================================================= */

static inline uint16_t to565(const Col &c) {
  return ((uint16_t)(c.r & 0xF8) << 8) | ((uint16_t)(c.g & 0xFC) << 3) | (c.b >> 3);
}

// A slightly warm white reads far more "premium" than pure #FFFFFF on an
// ST7789, which tends to run cool.
static inline Col warmWhite(float a) {
  if (a < 0.0f) a = 0.0f;
  if (a > 1.0f) a = 1.0f;
  return Col{ (uint8_t)(255.0f * a), (uint8_t)(252.0f * a), (uint8_t)(244.0f * a) };
}
static const Col INK = { 0, 0, 0 };

static inline float clamp01(float v) { return v < 0.0f ? 0.0f : (v > 1.0f ? 1.0f : v); }
static inline float lerpf(float a, float b, float t) { return a + (b - a) * t; }

// Progress of an animation, always clamped to 0..1 and safe against
// millis() wrap because the subtraction is unsigned.
float getAnimationProgress(unsigned long now, unsigned long start, unsigned long duration) {
  if (duration == 0) return 1.0f;
  unsigned long e = now - start;
  if (e >= duration) return 1.0f;
  return (float)e / (float)duration;
}

static float applyEase(uint8_t e, float p) {
  switch (e) {
    case EASE_SMOOTHSTEP:   return p * p * (3.0f - 2.0f * p);
    case EASE_OUT_CUBIC:  { float u = 1.0f - p; return 1.0f - u * u * u; }
    case EASE_IN_OUT_CUBIC: return (p < 0.5f) ? (4.0f * p * p * p)
                                              : (1.0f - powf(-2.0f * p + 2.0f, 3.0f) * 0.5f);
    default:                return p;
  }
}

static const Rect RECT_EMPTY = { 0, 0, 0, 0 };

static inline bool rEmpty(const Rect &r) { return r.w <= 0 || r.h <= 0; }

static Rect rClamp(float x, float y, float w, float h) {
  int16_t x0 = (int16_t)floorf(x), y0 = (int16_t)floorf(y);
  int16_t x1 = (int16_t)ceilf(x + w), y1 = (int16_t)ceilf(y + h);
  if (x0 < 0) x0 = 0;
  if (y0 < 0) y0 = 0;
  if (x1 > SCREEN_W) x1 = SCREEN_W;
  if (y1 > SCREEN_H) y1 = SCREEN_H;
  if (x1 <= x0 || y1 <= y0) return RECT_EMPTY;
  return Rect{ x0, y0, (int16_t)(x1 - x0), (int16_t)(y1 - y0) };
}

static Rect rUnion(const Rect &a, const Rect &b) {
  if (rEmpty(a)) return b;
  if (rEmpty(b)) return a;
  int16_t x0 = a.x < b.x ? a.x : b.x;
  int16_t y0 = a.y < b.y ? a.y : b.y;
  int16_t x1 = (a.x + a.w) > (b.x + b.w) ? (a.x + a.w) : (b.x + b.w);
  int16_t y1 = (a.y + a.h) > (b.y + b.h) ? (a.y + a.h) : (b.y + b.h);
  return Rect{ x0, y0, (int16_t)(x1 - x0), (int16_t)(y1 - y0) };
}

static bool rHit(const Rect &a, const Rect &b) {
  if (rEmpty(a) || rEmpty(b)) return false;
  return !(a.x + a.w <= b.x || b.x + b.w <= a.x ||
           a.y + a.h <= b.y || b.y + b.h <= a.y);
}


/* =========================================================================
   4.  FRAMEBUFFER FLUSH
   ========================================================================= */

void JuniFB::flush() {
  if (!hasDirty()) return;
  int16_t x = dx0, y = dy0;
  int16_t w = dx1 - dx0 + 1, h = dy1 - dy0 + 1;
  tft.startWrite();
  tft.setAddrWindow(x, y, w, h);
  for (int16_t r = 0; r < h; r++)
    tft.writePixels(&buf[(int32_t)(y + r) * SCREEN_W + x], (uint32_t)w);
  tft.endWrite();
  clearDirty();
}


/* =========================================================================
   5.  ANTIALIASED PRIMITIVES
   -------------------------------------------------------------------------
   Everything the panda is made of. Coordinates are floats and edges get
   real coverage antialiasing, which is what makes the face read as a smooth
   moulded shape rather than a stack of rounded rectangles -- and it lets
   the panda scale smoothly during transitions.
   ========================================================================= */

// Exact per-pixel coverage; used for spans thinner than 2 px.
static void spanExact(bool vertical, int fixed, float lo, float hi, const Col &c) {
  int a = (int)floorf(lo - 0.5f), b = (int)ceilf(hi + 0.5f);
  for (int i = a; i <= b; i++) {
    float l = lo > ((float)i - 0.5f) ? lo : ((float)i - 0.5f);
    float r = hi < ((float)i + 0.5f) ? hi : ((float)i + 0.5f);
    float cov = r - l;
    if (cov <= 0.004f) continue;
    if (cov > 1.0f) cov = 1.0f;
    if (vertical) fb.blend((int16_t)fixed, (int16_t)i, c, (uint8_t)(cov * 255.0f));
    else          fb.blend((int16_t)i, (int16_t)fixed, c, (uint8_t)(cov * 255.0f));
  }
}

// Horizontal span from xl..xr (continuous coords) on row y.
static void spanAA(float xl, float xr, int y, const Col &c) {
  if ((uint16_t)y >= SCREEN_H) return;
  float w = xr - xl;
  if (w <= 0.0f) return;
  if (w < 2.0f) { spanExact(false, y, xl, xr, c); return; }

  int iL = (int)ceilf(xl + 0.5f);      // first fully covered pixel
  int iR = (int)floorf(xr - 0.5f);     // last fully covered pixel
  if (iR >= iL) fb.hline((int16_t)iL, (int16_t)y, (int16_t)(iR - iL + 1), to565(c));

  float covL = ((float)iL - 0.5f) - xl;
  if (covL > 0.004f)
    fb.blend((int16_t)(iL - 1), (int16_t)y, c, (uint8_t)((covL > 1.0f ? 1.0f : covL) * 255.0f));
  float covR = xr - ((float)iR + 0.5f);
  if (covR > 0.004f)
    fb.blend((int16_t)(iR + 1), (int16_t)y, c, (uint8_t)((covR > 1.0f ? 1.0f : covR) * 255.0f));
}

// Vertical span from yt..yb on column x.
static void vspanAA(int x, float yt, float yb, const Col &c) {
  if ((uint16_t)x >= SCREEN_W) return;
  float h = yb - yt;
  if (h <= 0.0f) return;
  if (h < 2.0f) { spanExact(true, x, yt, yb, c); return; }

  int iT = (int)ceilf(yt + 0.5f);
  int iB = (int)floorf(yb - 0.5f);
  uint16_t col = to565(c);
  for (int y = iT; y <= iB; y++) fb.px((int16_t)x, (int16_t)y, col);

  float covT = ((float)iT - 0.5f) - yt;
  if (covT > 0.004f)
    fb.blend((int16_t)x, (int16_t)(iT - 1), c, (uint8_t)((covT > 1.0f ? 1.0f : covT) * 255.0f));
  float covB = yb - ((float)iB + 0.5f);
  if (covB > 0.004f)
    fb.blend((int16_t)x, (int16_t)(iB + 1), c, (uint8_t)((covB > 1.0f ? 1.0f : covB) * 255.0f));
}

/* Superellipse  |x/a|^n + |y/b|^n = 1.
     n = 2.0 -> ellipse
     n = 2.2 -> soft organic oval   (the eye patches)
     n = 2.8 -> squircle            (top of the face)
     n = 3.6 -> flatter, boxier     (bottom of the face)
   Separate exponents top/bottom give the face a softly domed top and a
   slightly flatter bottom -- the "bean" silhouette.
   `shear` slides each row sideways, tilting the shape organically.        */
static void fillSuperAA(float cx, float cy, float a, float b,
                        float nTop, float nBot, float shear, const Col &c) {
  if (a <= 0.2f || b <= 0.2f) return;
  int y0 = (int)floorf(cy - b) - 1, y1 = (int)ceilf(cy + b) + 1;
  for (int y = y0; y <= y1; y++) {
    float dy = (float)y - cy;
    float t = fabsf(dy) / b;
    if (t >= 1.0f) continue;
    float n = (dy < 0.0f) ? nTop : nBot;
    float f = 1.0f - powf(t, n);
    if (f <= 0.0f) continue;
    float xh = a * powf(f, 1.0f / n);
    float xc = cx + shear * dy;
    spanAA(xc - xh, xc + xh, y, c);
  }
}

static void fillCircleAA(float cx, float cy, float r, const Col &c) {
  if (r <= 0.25f) return;
  int y0 = (int)floorf(cy - r) - 1, y1 = (int)ceilf(cy + r) + 1;
  for (int y = y0; y <= y1; y++) {
    float dy = (float)y - cy;
    float d = r * r - dy * dy;
    if (d <= 0.0f) continue;
    float xh = sqrtf(d);
    spanAA(cx - xh, cx + xh, y, c);
  }
}

/* A tapered parabolic stroke. This one primitive draws every curved feature:
     rise > 0  -> arch, peak in the middle  (sleepy eyes, happy ^ eyes)
     rise < 0  -> dip,  low in the middle   (smiles, the little "w" mouth)
     rise ~ 0  -> soft flat line            (neutral mouth, closed eye)
   The stroke is thickest at the centre and thins toward the tips, which is
   what stops closed eyes looking like black rectangles.                   */
static void drawCurveAA(float cx, float cy, float halfW, float rise,
                        float thick, const Col &c) {
  if (halfW <= 0.4f || thick <= 0.2f) return;
  int x0 = (int)floorf(cx - halfW), x1 = (int)ceilf(cx + halfW);
  for (int x = x0; x <= x1; x++) {
    float u = ((float)x - cx) / halfW;
    if (u < -1.0f || u > 1.0f) continue;
    float u2 = u * u;
    float y = cy - rise * (1.0f - u2);
    float k = 1.0f - u2 * u2;
    float taper = 0.45f + 0.55f * sqrtf(k < 0.0f ? 0.0f : k);
    float t = thick * taper;
    vspanAA(x, y - t * 0.5f, y + t * 0.5f, c);
  }
}

// Small rounded triangle pointing down: the nose. Wide flat-ish top with
// softened corners, concave sides, blunt tip.
static void drawNoseAA(float cx, float topY, float w, float h, const Col &c) {
  if (w <= 1.0f || h <= 1.0f) return;
  int y0 = (int)floorf(topY), y1 = (int)ceilf(topY + h);
  for (int y = y0; y <= y1; y++) {
    float t = ((float)y - topY) / h;
    if (t < 0.0f || t > 1.0f) continue;
    float hw = (w * 0.5f) * powf(1.0f - t, 0.60f);
    if (t < 0.22f) {                              // round the top corners
      float u = t / 0.22f;
      hw *= 0.80f + 0.20f * sqrtf(u);
    }
    if (t > 0.78f) {                              // round the tip
      float u = (t - 0.78f) / 0.22f;
      float k = 1.0f - u * u;
      hw *= sqrtf(k < 0.0f ? 0.0f : k);
    }
    if (hw < 0.15f) continue;
    spanAA(cx - hw, cx + hw, y, c);
  }
}

// One small 4-point star. Deliberately tiny -- no confetti.
static void drawSparkleAA(float cx, float cy, float size, float alpha) {
  if (size < 2.0f || alpha <= 0.02f) return;
  Col c = { (uint8_t)(255.0f * alpha), (uint8_t)(216.0f * alpha), (uint8_t)(150.0f * alpha) };
  int s = (int)size;
  for (int dy = -s; dy <= s; dy++) {
    float u = fabsf((float)dy) / size;
    float k = 1.0f - u;
    float hw = 1.7f * k * k;
    if (hw > 0.12f) spanAA(cx - hw, cx + hw, (int)(cy + (float)dy), c);
  }
  for (int dx = -s; dx <= s; dx++) {
    float u = fabsf((float)dx) / size;
    float k = 1.0f - u;
    float hh = 1.7f * k * k;
    if (hh > 0.12f) vspanAA((int)(cx + (float)dx), cy - hh, cy + hh, c);
  }
  fillCircleAA(cx, cy, 1.3f, c);
}


/* =========================================================================
   6.  SCREEN LAYOUT
   -------------------------------------------------------------------------
   All panda geometry is expressed relative to the face centre at scale 1.0,
   so the whole face scales from a single multiplier.
   ========================================================================= */

static const float FACE_CX    = SCREEN_W * 0.5f;
