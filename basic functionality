/* =========================================================================
   8.  PANDA RENDERER
   -------------------------------------------------------------------------
   The ONLY code in the sketch that turns a face into pixels. The state
   machine never calls anything in here except setPandaExpression().

   To move to professionally rendered sprite frames later, replace the body
   of drawPanda() with a blit (see the note after it) -- no other part of
   the sketch needs to change.
   ========================================================================= */

void drawPandaMouth(float cx, float cy, float s, uint8_t style, const Col &c) {
  switch (style) {
    case MOUTH_W:                                     // tiny relaxed "w"
      drawCurveAA(cx - 5.5f * s, cy, 5.5f * s, -2.6f * s, 2.6f * s, c);
      drawCurveAA(cx + 5.5f * s, cy, 5.5f * s, -2.6f * s, 2.6f * s, c);
      break;
    case MOUTH_SMILE:     drawCurveAA(cx, cy,            10.0f * s, -4.0f * s, 2.8f * s, c); break;
    case MOUTH_BIG_SMILE: drawCurveAA(cx, cy - 1.0f * s, 13.0f * s, -6.5f * s, 3.3f * s, c); break;
    case MOUTH_FLAT:      drawCurveAA(cx, cy,             8.0f * s, -0.8f * s, 2.6f * s, c); break;
    case MOUTH_DOWN:      drawCurveAA(cx, cy + 1.0f * s,  8.5f * s,  2.2f * s, 2.6f * s, c); break;
  }
}

void drawPandaEye(float sx, float eyeCy, float s, int side,
                  const FaceState &f, const Col &hi) {
  float ea = EYE_HW * s * f.wide;
  float eb = EYE_HH * s;
  float shear = (side ? -EYE_SHEAR : EYE_SHEAR);

  uint8_t style = f.eyeStyle;
  if (style == EYE_WINK_R) style = side ? EYE_HAPPY : EYE_OVAL;

  switch (style) {
    case EYE_SLEEPY:   // soft shallow arch: peaceful, closed, never a rectangle
      drawCurveAA(sx, eyeCy + 3.0f * s, ea * 0.95f, 5.0f * s, 4.0f * s, INK);
      break;

    case EYE_HAPPY:    // deeper arch: happy squint
      drawCurveAA(sx, eyeCy + 5.0f * s, ea * 1.00f, 9.0f * s, 4.6f * s, INK);
      break;

    case EYE_OVAL:
    default: {
      float open = f.eyeOpen;
      if (open <= 0.08f) {                       // fully shut mid-blink
        drawCurveAA(sx, eyeCy, ea * 0.92f, 2.2f * s, 3.4f * s, INK);
        break;
      }
      float b   = eb * open;
      float ccy = eyeCy + (1.0f - open) * eb * 0.20f;   // lid closes from the top
      fillSuperAA(sx, ccy, ea, b, 2.15f, 2.45f, shear, INK);
      if (open > 0.55f) {                        // tiny catchlight
        float hx = sx + (side ? 1.0f : -1.0f) * ea * 0.30f + f.gazeX * 2.0f * s;
        float hy = ccy - b * 0.34f + f.gazeY * 2.0f * s;
        fillCircleAA(hx, hy, 3.5f * s * open, hi);
      }
      break;
    }
  }
}

void drawPanda(const FaceRender &r) {
  if (r.alpha < 0.02f || r.scale < 0.05f) return;

  const FaceState &f = r.f;
  float s  = r.scale;
  float cy = r.cy + f.bob;
  Col face = warmWhite(r.alpha);
  Col hi   = warmWhite(r.alpha);

  // 1. the white bean face -- no ears, no outline, no body
  fillSuperAA(r.cx, cy, FACE_HW * s, FACE_HH * s, FACE_N_TOP, FACE_N_BOT, 0.0f, face);

  // 2. the two black eye patches
  float eyeCy = cy + EYE_DY * s + f.gazeY * 2.0f * s;
  drawPandaEye(r.cx - EYE_DX * s, eyeCy, s, 0, f, hi);
  drawPandaEye(r.cx + EYE_DX * s, eyeCy, s, 1, f, hi);

  // 3. nose
  drawNoseAA(r.cx, cy + NOSE_DY * s, NOSE_W * s, NOSE_H * s, INK);

  // 4. mouth
  drawPandaMouth(r.cx, cy + MOUTH_DY * s, s, f.mouth, INK);

  // 5. optional single sparkle, clear of the face silhouette
  if (f.sparkle > 0.02f)
    drawSparkleAA(r.cx + 92.0f * s, cy - 46.0f * s,
                  8.0f * s * f.sparkle + 3.0f, f.sparkle * r.alpha);
}

/* Rendering-backend seam.
   drawPanda() above is the vector backend. A sprite backend would be:

     void drawPandaSprite(const uint16_t *rgb565, int w, int h, int x, int y);

   ...selected from a small table keyed by (curExpr, frame index). Because the
   application only ever calls setPandaExpression(), swapping the body of
   drawPanda() for a sprite blit requires no state-machine changes. Keep
   pandaBoxOf() in sync with whatever the sprite bounds are.               */

// Bounding box of the panda, with margin. Must enclose everything
// drawPanda() touches, including the sparkle.
static Rect pandaBoxOf(const FaceRender &r) {
  if (r.alpha < 0.02f || r.scale < 0.05f) return RECT_EMPTY;
  float s  = r.scale;
  float cy = r.cy + r.f.bob;
  float hw = FACE_HW * s + 4.0f;
  float hh = FACE_HH * s + 4.0f;
  float x0 = r.cx - hw, y0 = cy - hh, x1 = r.cx + hw, y1 = cy + hh;
  if (r.f.sparkle > 0.02f) {
    float sx = r.cx + 92.0f * s, sy = cy - 46.0f * s, sr = 8.0f * s + 6.0f;
    if (sx + sr > x1) x1 = sx + sr;
    if (sy - sr < y0) y0 = sy - sr;
  }
  return rClamp(x0, y0, x1 - x0, y1 - y0);
}


/* =========================================================================
   9.  TEXT ENGINE
   -------------------------------------------------------------------------
   The timer is not "big pixel font". FreeSansBold24pt7b is rendered at
   textSize 2 into a 1-bit off-screen canvas, then box-filtered DOWN to the
   target size. Because it is always a downscale, edges get real coverage
   antialiasing -- smooth numerals -- and the scale can be any float, which
   is what lets the timer grow and shrink continuously during transitions.
   ========================================================================= */

#define TXT_W 336
#define TXT_H  88

static GFXcanvas1 *txtC = nullptr;
static int16_t txtW = 0, txtH = 0;

static char           prepStr[16] = "";
static const GFXfont *prepFont    = nullptr;
static uint8_t        prepSize    = 0;
static bool           prepTabular = false;

// Renders `s` into the canvas at the origin. `tabular` measures an all-zeros
// reference string of the same length instead, so a counting clock keeps a
// rock-steady box and never jitters horizontally.
static void prepareText(const char *s, const GFXfont *f, uint8_t size, bool tabular) {
  if (prepFont == f && prepSize == size && prepTabular == tabular &&
      strcmp(prepStr, s) == 0) return;

  strncpy(prepStr, s, sizeof(prepStr) - 1);
  prepStr[sizeof(prepStr) - 1] = 0;
  prepFont = f; prepSize = size; prepTabular = tabular;

  txtC->fillScreen(0);
  txtC->setFont(f);
  txtC->setTextSize(size);
  txtC->setTextColor(1);
  txtC->setTextWrap(false);

  char ref[16];
  const char *meas = s;
  if (tabular) {
    size_t n = strlen(s);
    if (n > 15) n = 15;
    for (size_t i = 0; i < n; i++) ref[i] = (s[i] == ':') ? ':' : '0';
    ref[n] = 0;
    meas = ref;
  }

  int16_t bx, by; uint16_t bw, bh;
  txtC->getTextBounds(meas, 0, 0, &bx, &by, &bw, &bh);
  txtC->setCursor(-bx, -by);
  txtC->print(s);

  txtW = (int16_t)(bw > TXT_W ? TXT_W : bw);
  txtH = (int16_t)(bh > TXT_H ? TXT_H : bh);
}

// 4x4 box-filtered blit of the prepared glyph block, centred on (dcx,dcy).
static void blitTextAA(int16_t sw, int16_t sh, float dcx, float dcy,
                       float scale, float alpha, const Col &base) {
  if (sw <= 0 || sh <= 0 || scale <= 0.02f || alpha <= 0.004f) return;
  int dw = (int)lroundf((float)sw * scale), dh = (int)lroundf((float)sh * scale);
  if (dw <= 0 || dh <= 0) return;

  int x0 = (int)lroundf(dcx - (float)dw * 0.5f);
  int y0 = (int)lroundf(dcy - (float)dh * 0.5f);

  const uint8_t *sb = txtC->getBuffer();
  const int   rowBytes = (TXT_W + 7) / 8;
  const float inv  = 1.0f / scale;
  const int   SS   = 4;
  const float step = inv / (float)SS;

  for (int dy = 0; dy < dh; dy++) {
    int fy = y0 + dy;
    if ((uint16_t)fy >= SCREEN_H) continue;
    float sy = (float)dy * inv;
    for (int dx = 0; dx < dw; dx++) {
      int fx = x0 + dx;
      if ((uint16_t)fx >= SCREEN_W) continue;
      float sx = (float)dx * inv;
      int hit = 0;
      for (int j = 0; j < SS; j++) {
        int py = (int)(sy + ((float)j + 0.5f) * step);
        if (py < 0 || py >= sh) continue;
        const uint8_t *row = sb + (size_t)py * rowBytes;
        for (int i = 0; i < SS; i++) {
          int pxi = (int)(sx + ((float)i + 0.5f) * step);
          if (pxi < 0 || pxi >= sw) continue;
          if (row[pxi >> 3] & (0x80 >> (pxi & 7))) hit++;
        }
      }
      if (!hit) continue;
      float cov = ((float)hit / (float)(SS * SS)) * alpha;
      if (cov > 1.0f) cov = 1.0f;
      fb.blend((int16_t)fx, (int16_t)fy, base, (uint8_t)(cov * 255.0f));
    }
  }
}


