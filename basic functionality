void setPandaExpression(PandaExpression e) {
  unsigned long now = millis();
  if (e == PANDA_BLINK) {                 // one-shot blink on the current face
    blinking = true;
    blinkStart = now;
    return;
  }
  curExpr = e;
  seqStart = now;
  seqHolding = false;
}

static const char *stateName(AppState s) {
  switch (s) {
    case IDLE:        return "IDLE";
    case TIME_SELECT: return "TIME_SELECT";
    case STARTING:    return "STARTING";
    case FOCUS:       return "FOCUS";
    case BREAK:       return "BREAK";
    case CANCELING:   return "CANCELING";
    default:          return "FINISHED";
  }
}

void setAppState(AppState s) {
  unsigned long now = millis();
  AppState prev = state;
  state = s;
  stateEnter = now;

#if JUNI_DEBUG
  Serial.printf("[JUNI] %s -> %s  (%d min, %lu s left)\n",
                stateName(prev), stateName(s), focusMinutes,
                (unsigned long)remainingSeconds);
#endif

  switch (s) {
    case IDLE:
      remainingSeconds = (uint32_t)focusMinutes * 60;
      setPandaExpression(PANDA_IDLE);
      startTransition(LAYOUT_HOME,
                      (prev == TIME_SELECT) ? T_SELECT_OUT : 300,
                      EASE_IN_OUT_CUBIC);
      scheduleBlink(now, 1400, 2800);
      numAnimActive = false;
      break;

    case TIME_SELECT:
      startTransition(LAYOUT_SELECT, T_SELECT_IN, EASE_OUT_CUBIC);
      lastRotateMs = now;
      break;

    case STARTING:
      remainingSeconds = (uint32_t)focusMinutes * 60;
      startExprFired = false;
      numAnimActive  = false;
      startTransition(LAYOUT_HOME, T_START_LAYOUT, EASE_OUT_CUBIC);
      break;

    case FOCUS:
      // Do not stomp a START or WAKE animation that is still playing --
      // both auto-advance into PANDA_FOCUS when they finish.
      if (curExpr != PANDA_START && curExpr != PANDA_WAKE)
        setPandaExpression(PANDA_FOCUS);
      if (prev != BREAK) { lastTick = now; tickRemainder = 0; }
      scheduleBlink(now, 4000, 8000);
      nextGazeAt = now + random(4000, 9000);
      startTransition(LAYOUT_HOME, 0, EASE_LINEAR);
      break;

    case BREAK:
      tickRemainder = (uint32_t)(now - lastTick);
      if (tickRemainder > 999) tickRemainder = 999;
      setPandaExpression(PANDA_BREAK);
      break;

    case CANCELING:
      cancelShrunk = false;
      setPandaExpression(PANDA_CANCEL);
      break;

    case FINISHED:
      remainingSeconds = 0;
      setPandaExpression(PANDA_FINISH);
      break;
  }
}

void updateStateMachine() {
  unsigned long now = millis();

  switch (state) {
    case TIME_SELECT:
      // Idle too long in time select: drift back home without starting.
      if (now - lastRotateMs >= SELECT_TIMEOUT) setAppState(IDLE);
      break;

    case STARTING:
      if (!startExprFired && now - stateEnter >= T_START_EXPR) {
        startExprFired = true;
        setPandaExpression(PANDA_START);
      }
      if (now - stateEnter >= T_STARTING) setAppState(FOCUS);
      break;

    case CANCELING:
      if (!cancelShrunk && now - stateEnter >= T_CANCEL_SHRNK) {
        cancelShrunk = true;
        startTransition(LAYOUT_CANCEL, 320, EASE_IN_OUT_CUBIC);
      }
      if (now - stateEnter >= T_CANCEL) setAppState(IDLE);
      break;

    default:
      break;
  }
}


/* =========================================================================
   12.  INPUT
   ========================================================================= */

static int           lastS1       = HIGH;
static unsigned long lastDetentMs = 0;

static bool           btnRawLast   = false;
static bool           btnStable    = false;
static unsigned long  btnRawChange = 0;
static unsigned long  btnDownAt    = 0;
static bool           longFired    = false;
static const uint16_t BTN_DEBOUNCE = 25;

static void onRotate(int dir) {
  if (state != IDLE && state != TIME_SELECT) return;

  int m = focusMinutes + dir * 5;
  if (m < 5)   m = 5;
  if (m > 120) m = 120;
  bool changed = (m != focusMinutes);
  focusMinutes = m;
  remainingSeconds = (uint32_t)focusMinutes * 60;

  if (state == IDLE) {
    setAppState(TIME_SELECT);      // the first detent also applies its +/-5
  } else {
    lastRotateMs = millis();
    if (changed) { numAnimStart = millis(); numAnimActive = true; }
  }
}

void updateEncoder() {
  int s1 = digitalRead(ENC_S1);
  if (s1 == lastS1) return;
  lastS1 = s1;

  if (s1 != LOW) return;
  unsigned long now = millis();
  if (now - lastDetentMs < 4) return;      // contact-bounce guard
  lastDetentMs = now;

  bool cw = (digitalRead(ENC_S2) == HIGH); // same convention as the original
#if ENC_INVERT
  cw = !cw;
#endif
  onRotate(cw ? +1 : -1);
}

static void onShortPress() {
  switch (state) {
    case IDLE:
      setAppState(STARTING);                 // start with whatever is on screen
      break;
    case TIME_SELECT:
      setAppState(STARTING);
      break;
    case FOCUS:
      setAppState(BREAK);
      break;
    case BREAK:
      setPandaExpression(PANDA_WAKE);
      timerHold = true;
      wakeStart = millis();
      setAppState(FOCUS);
      break;
    case FINISHED:
      setAppState(IDLE);
      break;
    default:                                 // STARTING / CANCELING ignore input
      break;
  }
}

void updateButton() {
  unsigned long now = millis();
  bool raw = (digitalRead(ENC_KEY) == LOW);

  if (raw != btnRawLast) { btnRawLast = raw; btnRawChange = now; }

  if (raw != btnStable && now - btnRawChange >= BTN_DEBOUNCE) {
    btnStable = raw;
    if (raw) { btnDownAt = now; longFired = false; }
    else if (!longFired) onShortPress();
  }

  // Long press is measured while held, never blocking, and only cancels a
  // live session. The matching release is swallowed by `longFired`.
  if (btnStable && !longFired && (state == FOCUS || state == BREAK) &&
      now - btnDownAt >= LONG_PRESS_MS) {
    longFired = true;
    setAppState(CANCELING);
  }
}


/* =========================================================================
   13.  COUNTDOWN
   -------------------------------------------------------------------------
   Never draws anything. Accumulates in whole seconds so a long render frame
   cannot lose or drift a tick, and keeps the sub-second remainder across a
   pause so resuming is exact.
   ========================================================================= */

void updateTimer() {
  if (state != FOCUS) return;
  unsigned long now = millis();

  if (timerHold) {                       // waiting for the WAKE animation
    if (now - wakeStart < T_WAKE) return;
    timerHold = false;
    lastTick  = now - tickRemainder;
  }

  while (now - lastTick >= 1000) {
    lastTick += 1000;
    if (remainingSeconds > 0) remainingSeconds--;
    if (remainingSeconds == 0) { setAppState(FINISHED); return; }
  }
}


/* =========================================================================
   14.  ANIMATION UPDATE
   ========================================================================= */

static bool          animDue    = false;
static unsigned long lastAnimMs = 0;

// open -> narrow -> shut -> narrow -> open, 240 ms total
static float blinkEnvelope(uint32_t t) {
  if (t <  70) return lerpf(1.00f, 0.35f, (float)t          / 70.0f);
  if (t < 120) return lerpf(0.35f, 0.00f, (float)(t -  70)  / 50.0f);
  if (t < 170) return lerpf(0.00f, 0.35f, (float)(t - 120)  / 50.0f);
  if (t < 240) return lerpf(0.35f, 1.00f, (float)(t - 170)  / 70.0f);
  return 1.0f;
}

static float breathOffset(unsigned long now) {
#if JUNI_BREATHING
  if ((long)(now - nextBreathAt) >= 0) {
    breathStart  = now;
    nextBreathAt = now + random(5200, 8600);
  }
  uint32_t t = (uint32_t)(now - breathStart);
  if (t < BREATH_MS) return -1.5f * sinf(((float)t / (float)BREATH_MS) * (float)PI);
#endif
  return 0.0f;
}

static FaceState faceFromKey(const FaceKey &k) {
  FaceState f;
  f.eyeOpen  = k.eyeOpen;
  f.eyeStyle = k.eyeStyle;
  f.mouth    = k.mouth;
  f.bob      = k.bob;
  f.wide     = k.wide;
  f.gazeX    = 0.0f;
  f.gazeY    = k.gazeY;
  f.sparkle  = k.sparkle;
  return f;
}

static void updateLayoutTween(unsigned long now) {
  if (!lActive) { lNow = lTo; return; }
  float p = getAnimationProgress(now, lStart, lDur);
  float e = applyEase(lEase, p);
  lNow.pandaCy    = lerpf(lFrom.pandaCy,    lTo.pandaCy,    e);
  lNow.pandaScale = lerpf(lFrom.pandaScale, lTo.pandaScale, e);
  lNow.pandaAlpha = lerpf(lFrom.pandaAlpha, lTo.pandaAlpha, e);
  lNow.timerCy    = lerpf(lFrom.timerCy,    lTo.timerCy,    e);
  lNow.timerScale = lerpf(lFrom.timerScale, lTo.timerScale, e);
  lNow.timerAlpha = lerpf(lFrom.timerAlpha, lTo.timerAlpha, e);
  if (p >= 1.0f) { lActive = false; lNow = lTo; }
}

static void updateFaceSequence(unsigned long now) {
  const FaceSeq *s = &PANDA_SEQ[curExpr];

  // Walk auto-advance chains (START -> FOCUS etc). Bounded, never recursive.
  for (int guard = 0; guard < 4; guard++) {
    uint32_t t = (uint32_t)(now - seqStart);
    if (t < s->k[s->n - 1].t) break;
    if (s->next == PANDA_NONE) break;
    curExpr  = (PandaExpression)s->next;
    seqStart = now;
    s = &PANDA_SEQ[curExpr];
  }

  uint32_t t = (uint32_t)(now - seqStart);
  const FaceKey &last = s->k[s->n - 1];

  if (t >= last.t) {
    faceNow    = faceFromKey(last);
    seqHolding = true;
  } else {
    seqHolding = false;
    uint8_t i = 0;
    while (i + 1 < s->n && t >= s->k[i + 1].t) i++;
    const FaceKey &a = s->k[i];
    const FaceKey &b = s->k[i + 1];
    float span = (float)(b.t - a.t);
    float p    = span > 0.0f ? (((float)t - (float)a.t) / span) : 1.0f;
    float e    = applyEase(EASE_SMOOTHSTEP, clamp01(p));

    faceNow = faceFromKey(a);                 // enums step at the earlier key
    faceNow.eyeOpen = lerpf(a.eyeOpen, b.eyeOpen, e);
    faceNow.bob     = lerpf(a.bob,     b.bob,     e);
    faceNow.wide    = lerpf(a.wide,    b.wide,    e);
    faceNow.gazeY   = lerpf(a.gazeY,   b.gazeY,   e);
    faceNow.sparkle = lerpf(a.sparkle, b.sparkle, e);
  }

  // ---- modifiers, layered on top of whatever the base expression is ----

  if (s->blink && seqHolding && faceNow.eyeStyle == EYE_OVAL) {
    if (!blinking && (long)(now - nextBlinkAt) >= 0) { blinking = true; blinkStart = now; }
    if (blinking) {
      uint32_t bt = (uint32_t)(now - blinkStart);
      if (bt >= BLINK_MS) { blinking = false; nextBlinkAt = now + random(blinkMin, blinkMax); }
      else faceNow.eyeOpen *= blinkEnvelope(bt);
    }
  } else {
    blinking = false;
  }

  if (s->breathe && seqHolding) faceNow.bob += breathOffset(now);

  // Occasional 1-2 px gaze drift while focusing, then back to centre.
  if (state == FOCUS && seqHolding && faceNow.eyeStyle == EYE_OVAL) {
    if ((long)(now - nextGazeAt) >= 0) {
      gazeStart  = now;
      gazeTarget = (int)random(-1, 2);
      nextGazeAt = now + random(5000, 11000);
    }
    uint32_t gt = (uint32_t)(now - gazeStart);
    if (gt < 1500)
      faceNow.gazeX += (float)gazeTarget * sinf(((float)gt / 1500.0f) * (float)PI);
  }
}

void updateAnimation() {
  unsigned long now = millis();
  if (now - lastAnimMs < FRAME_MS) return;
  lastAnimMs = now;
  animDue = true;

  updateLayoutTween(now);
  updateFaceSequence(now);
}


/* =========================================================================
   15.  RENDER ORCHESTRATION
   -------------------------------------------------------------------------
   Per frame: work out what each layer should look like, hash it, redraw only
   the layers whose hash changed, and push only the union of the affected
   rectangles. The framebuffer persists, so an unchanged layer costs nothing.
   ========================================================================= */

static Rect     lastBox[L_COUNT] = { RECT_EMPTY, RECT_EMPTY, RECT_EMPTY };
static uint32_t lastSig[L_COUNT] = { 0, 0, 0 };

static void formatTimeStr(char *out, size_t n) {
  if (state == IDLE || state == TIME_SELECT) snprintf(out, n, "%02d:00", focusMinutes);
  else snprintf(out, n, "%02lu:%02lu",
                (unsigned long)(remainingSeconds / 60),
                (unsigned long)(remainingSeconds % 60));
}

static void computeFaceRender(FaceRender &r) {
  r.cx    = FACE_CX;
  r.cy    = lNow.pandaCy;
  r.scale = lNow.pandaScale;
  r.alpha = lNow.pandaAlpha;
  r.f     = faceNow;
}

static void computeTimerRender(TimerRender &t) {
  unsigned long now = millis();
  const GFXfont *font = &FreeSansBold24pt7b;
  uint8_t size    = 2;
  bool    tabular = true;
  float   cy    = lNow.timerCy;
  float   scale = lNow.timerScale;
  float   alpha = lNow.timerAlpha;
  char    s[16];

  if (state == FINISHED) {
    uint32_t e = (uint32_t)(now - stateEnter);
    if (e >= T_FIN_ANIM) {
      // "Well Done!" takes the timer's place. Kept smaller than the panda.
      strncpy(s, "Well Done!", sizeof(s) - 1);
      s[sizeof(s) - 1] = 0;
      font = &FreeSansBold12pt7b;
      size = 2;
      tabular = false;
      scale = 0.80f;
      alpha = clamp01((float)(e - T_FIN_ANIM) / (float)T_WELLDONE_IN);
    } else {
      strncpy(s, "00:00", sizeof(s) - 1);
      s[sizeof(s) - 1] = 0;
      if (e > T_FIN_FADE_AT)
        alpha = 1.0f - clamp01((float)(e - T_FIN_FADE_AT) /
                               (float)(T_FIN_ANIM - T_FIN_FADE_AT));
    }
  } else {
    formatTimeStr(s, sizeof(s));

    // Value-change animation in time select: quick grow + fade-in + settle.
    if (state == TIME_SELECT && numAnimActive) {
      float p = getAnimationProgress(now, numAnimStart, T_NUM_POP);
      float e = applyEase(EASE_OUT_CUBIC, p);
      scale *= lerpf(0.90f, 1.00f, e);
      alpha *= lerpf(0.40f, 1.00f, e);
      cy    += lerpf(6.0f,  0.0f,  e);
      if (p >= 1.0f) numAnimActive = false;
    }
  }

  prepareText(s, font, size, tabular);

  if (txtW > 0 && (float)txtW * scale > TIMER_MAX_W) scale = TIMER_MAX_W / (float)txtW;

  strncpy(t.str, s, sizeof(t.str) - 1);
  t.str[sizeof(t.str) - 1] = 0;
  t.cy = cy; t.scale = scale; t.alpha = alpha;
  t.w = txtW; t.h = txtH;
}

static inline uint32_t mixh(uint32_t h, uint32_t v) { return (h * 16777619u) ^ v; }
static inline uint32_t qz(float v, float step) { return (uint32_t)(int32_t)lroundf(v / step); }

static uint32_t faceSig(const FaceRender &r) {
  uint32_t h = 2166136261u;
  h = mixh(h, qz(r.cy, 0.25f));
  h = mixh(h, qz(r.scale, 0.004f));
  h = mixh(h, qz(r.alpha, 0.008f));
  h = mixh(h, qz(r.f.eyeOpen, 0.02f));
  h = mixh(h, r.f.eyeStyle);
  h = mixh(h, r.f.mouth);
  h = mixh(h, qz(r.f.bob, 0.25f));
  h = mixh(h, qz(r.f.wide, 0.01f));
  h = mixh(h, qz(r.f.gazeX, 0.20f));
  h = mixh(h, qz(r.f.gazeY, 0.05f));
  h = mixh(h, qz(r.f.sparkle, 0.03f));
  return h;
}

static uint32_t timerSig(const TimerRender &t) {
  uint32_t h = 2166136261u;
  for (const char *p = t.str; *p; p++) h = mixh(h, (uint8_t)*p);
  h = mixh(h, qz(t.cy, 0.25f));
  h = mixh(h, qz(t.scale, 0.003f));
  h = mixh(h, qz(t.alpha, 0.008f));
  h = mixh(h, (uint32_t)t.w);
  return h;
}

static uint32_t dotSig() { return 0xD07u; }   // static for now, by design

static void drawLayer(uint8_t i) {
  switch (i) {
    case L_PANDA: drawPanda(fr);   break;
    case L_TIMER: drawTimer(tr);   break;
    case L_DOT:   drawStatusDot(); break;
  }
}

static Rect boxOfLayer(uint8_t i) {
  switch (i) {
    case L_PANDA: return pandaBoxOf(fr);
    case L_TIMER: return timerBoxOf(tr);
    default:      return dotBox();
  }
}

void renderIfNeeded() {
  if (!animDue) return;
  animDue = false;

  computeFaceRender(fr);
  computeTimerRender(tr);

  uint32_t sig[L_COUNT]  = { faceSig(fr), timerSig(tr), dotSig() };
  Rect     want[L_COUNT] = { boxOfLayer(L_PANDA), boxOfLayer(L_TIMER), boxOfLayer(L_DOT) };
  Rect     span[L_COUNT];
  bool     dirty[L_COUNT];

  for (uint8_t i = 0; i < L_COUNT; i++) {
    dirty[i] = (sig[i] != lastSig[i]);
    span[i]  = rUnion(lastBox[i], want[i]);
  }

  // If a dirty layer's span touches a clean layer, that clean layer has to be
  // redrawn too -- otherwise erasing would punch a hole in it.
  bool changed = true;
  while (changed) {
    changed = false;
    for (uint8_t i = 0; i < L_COUNT; i++) {
      if (!dirty[i]) continue;
      for (uint8_t j = 0; j < L_COUNT; j++) {
        if (dirty[j] || i == j) continue;
        if (rHit(span[i], span[j])) { dirty[j] = true; changed = true; }
      }
    }
  }

  bool any = false;
  for (uint8_t i = 0; i < L_COUNT; i++) if (dirty[i]) { any = true; break; }
  if (!any) return;

  fb.clearDirty();
  for (uint8_t i = 0; i < L_COUNT; i++) if (dirty[i]) fb.fillRectR(span[i], 0x0000);
  for (uint8_t i = 0; i < L_COUNT; i++) if (dirty[i]) drawLayer(i);
  for (uint8_t i = 0; i < L_COUNT; i++) if (dirty[i]) { lastBox[i] = want[i]; lastSig[i] = sig[i]; }

  fb.flush();
}

// One-time full paint at boot. The only place fillScreen() is ever used.
static void fullRepaint() {
  unsigned long now = millis();
  updateLayoutTween(now);
  updateFaceSequence(now);
  computeFaceRender(fr);
  computeTimerRender(tr);

  fb.clearDirty();
  fb.fillScreen(0x0000);
  for (uint8_t i = 0; i < L_COUNT; i++) {
    lastBox[i] = boxOfLayer(i);
    drawLayer(i);
  }
  lastSig[L_PANDA] = faceSig(fr);
  lastSig[L_TIMER] = timerSig(tr);
  lastSig[L_DOT]   = dotSig();
  fb.flush();
}


/* =========================================================================
   16.  SETUP / LOOP
   ========================================================================= */

void setup() {
  Serial.begin(115200);
  delay(50);

  // ---------- display (unchanged from the working configuration) ---------
  SPI.begin(TFT_SCLK, -1, TFT_MOSI, TFT_CS);
  tft.init(240, 320);
  tft.setRotation(0);
  tft.setSPISpeed(TFT_SPI_HZ);
  // Many ST7789 panels ship in inverted mode; without this, black reads cyan.
  tft.invertDisplay(true);
  tft.fillScreen(ST77XX_BLACK);

  // ---------- encoder ----------
  pinMode(ENC_S1,  INPUT_PULLUP);
  pinMode(ENC_S2,  INPUT_PULLUP);
  pinMode(ENC_KEY, INPUT_PULLUP);
  lastS1     = digitalRead(ENC_S1);
  btnRawLast = (digitalRead(ENC_KEY) == LOW);
  btnStable  = btnRawLast;

  randomSeed((unsigned long)esp_random());

  // ---------- offscreen buffers ----------
  if (!fb.begin()) {
    tft.setTextColor(ST77XX_WHITE);
    tft.setCursor(10, 40);
    tft.print("FB alloc failed");
    Serial.println("[JUNI] framebuffer allocation failed");
    while (true) delay(1000);
  }
  txtC = new GFXcanvas1(TXT_W, TXT_H);
  if (!txtC || !txtC->getBuffer()) {
    Serial.println("[JUNI] text canvas allocation failed");
    while (true) delay(1000);
  }

  Serial.printf("[JUNI] framebuffer %u B, psram free %u, heap free %u\n",
                (unsigned)(SCREEN_W * SCREEN_H * 2),
                (unsigned)ESP.getFreePsram(), (unsigned)ESP.getFreeHeap());

  // ---------- initial state ----------
  remainingSeconds = (uint32_t)focusMinutes * 60;
  lNow = lTo = lFrom = LAYOUT_HOME;
  state = IDLE;
  stateEnter = millis();
  setPandaExpression(PANDA_IDLE);
  scheduleBlink(millis(), 1200, 2200);
  nextBreathAt = millis() + 3000;

  fullRepaint();
  Serial.println("[JUNI] ready");
}

void loop() {
  updateEncoder();        // rotation -> time selection
  updateButton();         // short press / long press
  updateTimer();          // countdown, drawing-free
  updateStateMachine();   // timed state transitions
  updateAnimation();      // layout tween + face keyframes (self-gated ~33 fps)
  renderIfNeeded();       // dirty-layer redraw + partial flush
}
